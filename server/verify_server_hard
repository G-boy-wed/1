# C) 日记本创建入队去重（engine 单元，mock ctx）
# --------------------------------------------------------------------------- #
def _unwrap(tool_result):
    """_text()/_error() 返回 MCP content 包裹：{'content':[{'type':'text','text': json_str}]}。"""
    try:
        txt = tool_result["content"][0]["text"]
        return json.loads(txt)
    except Exception:
        return tool_result


def test_diary_dedup():
    print("\n== C) create_diary_book 入队去重护栏 ==")
    srv = load_module("lsrv_c", str(SERVER_PY))
    import mcp_engine  # 同目录模块
    calls = []
    class Ctx:
        data_dir = str(HERE / ".verify_tmp")
        default_device = "android-phone"
        def enqueue(self, data):
            calls.append(data)
            return {"command": {"id": "cmd_%d" % len(calls)}}
    os.makedirs(Ctx.data_dir, exist_ok=True)
    try:
        eng = mcp_engine.McpEngine(ctx=Ctx(), tools=[])
        r1 = _unwrap(eng._create_diary_book_guarded({"name": "TA 的日记", "device_id": "android-phone"}))
        r2 = _unwrap(eng._create_diary_book_guarded({"name": "TA 的日记", "device_id": "android-phone"}))
        check("首次创建入队(queued=True)", r1.get("queued") is True, str(r1))
        check("二次同名牌被去重(queued=False)", r2.get("queued") is False and r2.get("deduplicated") is True, str(r2))
        check("去重后仅入队 1 次", len(calls) == 1, "calls=%d" % len(calls))
        check("附带确定性 book_id 提示", bool((calls[0].get("payload") or {}).get("book_id")), str(calls[0].get("payload")))
        # 不同书名应各自入队
        eng._create_diary_book_guarded({"name": "另一本", "device_id": "android-phone"})
        check("不同书名可独立入队", len(calls) == 2, "calls=%d" % len(calls))
    finally:
        shutil.rmtree(Ctx.data_dir, ignore_errors=True)


def main():
    test_token_normalize_unit()
    test_e2e_token_and_media()
    test_diary_dedup()
    print("\n" + "=" * 60)
    print("PASS=%d  FAIL=%d" % (PASS, FAIL))
    if FAIL == 0:
        print("PERFECT: SERVER_HARDENING_PASSED")
    else:
        print("FAILED: SERVER_HARDENING_HAS_ERRORS")
    print("=" * 60)
    sys.exit(0 if FAIL == 0 else 1)


if __name__ == "__main__":
    main()
