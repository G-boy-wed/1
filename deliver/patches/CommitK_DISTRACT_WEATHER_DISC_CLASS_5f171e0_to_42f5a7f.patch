+            boolean highLevel = PolicyStore.disciplineLevel(ctx) >= 2;
+            if (strictMode || highLevel) {
+                // 训诫开启（严厉 / 中档及以上）：原本温柔的语气升级为 strict（渲染为 danger 红 + 更硬话术），
