diff --git a/android/app/src/main/java/dev/linjian/peek/PolicySync.java b/android/app/src/main/java/dev/linjian/peek/PolicySync.java
new file mode 100644
index 0000000..70df4b1
--- /dev/null
+++ b/android/app/src/main/java/dev/linjian/peek/PolicySync.java
@@ -0,0 +1,102 @@
+package dev.linjian.peek;
+
+import android.content.Context;
+
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+
+/**
+ * 策略同步：把「掌心窗内最后写入的管理配置」best-effort 推给服务器，
+ * 让 MCP / 陪伴对象侧读到与手机端一致的管理要求。
+ *
+ * 推送内容（两段，各自独立成功/失败，互不影响）：
+ *  1. /api/tour/schedule：巡回查岗配置（开关、间隔、冷却、安静/深夜时段、强拉阈值）
+ *  2. /api/discipline  ：训诫配置（开关、模式、档位）
+ *
+ * 设计要点：
+ *  - 只推本机真实存在的配置，不硬编码假值（缺省键服务端保留原值，last-write-wins）；
+ *  - best-effort：无服务器地址/网络失败时静默跳过，本机始终生效；
+ *  - 保存设置时调用一次；陪伴服务启动时调用一次，运行期每 15 分钟对齐一次，
+ *    保证哪怕保存那一刻没网，最终也会同步到 MCP 读取的同一份状态。
+ */
+public final class PolicySync {
+
+    /** 距上次成功推送的最小间隔（运行期对齐频率）。 */
+    private static final long MIN_INTERVAL_MS = 15 * 60_000L;
+    private static volatile long lastPushAt = 0;
+
+    private PolicySync() { }
+
+    /** 推送全部管理配置（巡回 + 训诫）。force=true 忽略最小间隔（保存动作用）。 */
+    public static void pushAll(Context ctx, boolean force) {
+        try {
+            long now = System.currentTimeMillis();
+            if (!force && now - lastPushAt < MIN_INTERVAL_MS) return;
+            lastPushAt = now;
+            final Context app = ctx.getApplicationContext();
+            final String base = AppPrefs.server(app), token = AppPrefs.token(app);
+            if (base == null || base.trim().isEmpty()) return; // 未配置服务器：本机生效即可
+
+            new Thread(() -> {
+                try {
+                    JSONObject tour = new JSONObject();
+                    tour.put("enabled", PolicyStore.checkinEnabled(app));
+                    tour.put("check_in_interval_minutes", PolicyStore.randomUpper(app));
+                    tour.put("cooldown_minutes", PolicyStore.cooldownMinutes(app));
+                    JSONObject q = new JSONObject();
+                    q.put("start", PolicyStore.quietStart(app)); q.put("end", PolicyStore.quietEnd(app));
+                    tour.put("quiet_hours", q);
+                    JSONObject n = new JSONObject();
+                    n.put("start", PolicyStore.nightStart(app)); n.put("end", PolicyStore.nightEnd(app));
+                    tour.put("night_hours", n);
+                    tour.put("force_back_miss_threshold", PolicyStore.forceBackThreshold(app));
+                    request(base, token, "POST", "/api/tour/schedule", tour.toString());
+                } catch (Exception ignored) { }
+                try {
+                    JSONObject dis = new JSONObject();
+                    dis.put("enabled", PolicyStore.disciplineEnabled(app));
+                    dis.put("mode", PolicyStore.disciplineMode(app));
+                    dis.put("level", PolicyStore.disciplineLevel(app));
+                    request(base, token, "POST", "/api/discipline", dis.toString());
+                } catch (Exception ignored) { }
+            }, "policy-sync").start();
+        } catch (Exception ignored) { }
+    }
+
+    /** 便捷重载：默认立即推送（保存动作）。 */
+    public static void pushAll(Context ctx) { pushAll(ctx, true); }
+
+    private static String request(String base, String token, String method, String path, String body) {
+        HttpURLConnection conn = null;
+        try {
+            String urlStr = base.replaceAll("/+$", "") + path;
+            conn = (HttpURLConnection) new URL(urlStr).openConnection();
+            conn.setRequestMethod(method);
+            conn.setConnectTimeout(6000);
+            conn.setReadTimeout(8000);
+            if (token != null && !token.trim().isEmpty()) conn.setRequestProperty("Authorization", "Bearer " + token.trim());
+            conn.setRequestProperty("Content-Type", "application/json; charset=utf-8");
+            if (body != null && (method.equals("POST") || method.equals("PUT"))) {
+                conn.setDoOutput(true);
+                byte[] out = body.getBytes(StandardCharsets.UTF_8);
+                conn.setFixedLengthStreamingMode(out.length);
+                try (OutputStream os = conn.getOutputStream()) { os.write(out); }
+            }
+            int code = conn.getResponseCode();
+            InputStream is = code >= 400 ? conn.getErrorStream() : conn.getInputStream();
+            ByteArrayOutputStream bos = new ByteArrayOutputStream();
+            if (is != null) { byte[] buf = new byte[1024]; int n; while ((n = is.read(buf)) > 0) bos.write(buf, 0, n); }
+            return "HTTP " + code + " " + bos.toString("UTF-8");
+        } catch (Exception e) {
+            return "ERROR " + ScreenshotService.shortMsg(e);
+        } finally {
+            try { if (conn != null) conn.disconnect(); } catch (Exception ignored) { }
+        }
+    }
+}
diff --git a/android/app/src/main/java/dev/linjian/peek/PopupMutex.java b/android/app/src/main/java/dev/linjian/peek/PopupMutex.java
new file mode 100644
index 0000000..70b5c33
--- /dev/null
+++ b/android/app/src/main/java/dev/linjian/peek/PopupMutex.java
@@ -0,0 +1,55 @@
+package dev.linjian.peek;
+
+/**
+ * 弹窗互斥仲裁器：保证全 App 同一时刻只有一个弹窗（悬浮窗或弹窗 Activity）展示。
+ *
+ * 背景（修复「弹窗重复冲突」）：
+ *  - 悬浮窗通道有两条独立实现（PullBackOverlay 分级拉回 / AlertCenterOverlay 居中弹窗），
+ *    各自持有自己的视图引用，互相不知道对方存在，会同时叠在屏幕上；
+ *  - 悬浮窗 TYPE_APPLICATION_OVERLAY 层级高于 Activity：Activity 兜底通道
+ *    （PullBackActivity / AlertCenterActivity）启动时，若已有悬浮窗在屏，
+ *    会出现「悬浮窗 + Activity」双重展示。
+ *
+ * 规则（last-write-wins，永远只有一个）：
+ *  - 任何通道展示前调用 {@link #beforeShow(String)}：先移除其它通道的悬浮窗，
+ *    并登记自己为当前占用者；后到的弹窗替换先到的，不排队不叠加。
+ */
+public final class PopupMutex {
+
+    /** 分级拉回弹窗（悬浮窗 + Activity 兜底共用一个 key）。 */
+    public static final String PULL_BACK = "pull_back";
+    /** 屏幕居中弹窗（悬浮窗 + Activity 兜底共用一个 key）。 */
+    public static final String CENTER_ALERT = "center_alert";
+
+    private static volatile String owner = "";
+    private static long lastShownAt = 0;
+
+    private PopupMutex() { }
+
+    /**
+     * 展示前调用：移除其它通道的悬浮窗，把自己登记为当前占用者。
+     * 之后调用方负责真正 addView / setContentView；失败也要调 {@link #onDismissed(String)} 释放。
+     */
+    public static void beforeShow(String who) {
+        if (who == null) return;
+        try {
+            if (!PULL_BACK.equals(who)) PullBackOverlay.dismiss();
+            if (!CENTER_ALERT.equals(who)) AlertCenterOverlay.dismiss();
+        } catch (Exception ignored) { }
+        owner = who;
+        lastShownAt = System.currentTimeMillis();
+    }
+
+    /** 弹窗被用户点掉 / 移除后调用：只有当前占用者本人能清空登记。 */
+    public static void onDismissed(String who) {
+        if (who != null && who.equals(owner)) owner = "";
+    }
+
+    /** 当前占用者（诊断用）。 */
+    public static String currentOwner() { return owner; }
+
+    /** 距上次任意弹窗展示的毫秒数（诊断/限频用）。 */
+    public static long msSinceLastShown() {
+        return lastShownAt == 0 ? Long.MAX_VALUE : System.currentTimeMillis() - lastShownAt;
+    }
+}
