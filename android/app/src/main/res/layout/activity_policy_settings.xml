<?xml version="1.0" encoding="utf-8"?>
<!-- App 内「查岗与管束」设置页：所有参数本机存储、改完立即生效、不用重启 App/后端/MCP。
     布局只提供搜索框与容器，分组与控件由 PolicySettingsActivity 动态构建（便于折叠/搜索/逐项说明）。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7F4F2">

    <LinearLayout
        android:id="@+id/policyRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <EditText
            android:id="@+id/policySearch"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="搜索设置项…"
            android:singleLine="true"
            android:background="@drawable/card_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textSize="13sp"
            android:textColor="#FF2D3E39" />

        <TextView
            android:id="@+id/policyStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#FF6E6282"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:id="@+id/policyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/policyChangeLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#FF8B7D99"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>
</ScrollView>
