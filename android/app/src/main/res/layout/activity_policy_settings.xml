<?xml version="1.0" encoding="utf-8"?>
<!-- App 内「查岗与管束」设置页：把巡回周期、安静时段、单 App 锁阈值、
     豁免应用、弹窗语气、拉回分级阈值等全部交给用户自己设定，保存后立即生效。
     这里保存的就是 MCP set_tour_schedule 用的同一份配置（服务端 tour_schedule.json），
     两边改任意一边，另一边读到的都是最新值。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7F4F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="查岗与管束" android:textStyle="bold" android:textSize="18sp" android:textColor="#FF2D3E39" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="这里所有的周期、时间与规则都由你自己定；保存后立即生效，和 MCP 的 set_tour_schedule 是同一份配置。"
            android:textSize="11sp" android:textColor="#FF6E6282" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" />

        <CheckBox android:id="@+id/policyEnabled"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="开启巡回查岗" android:textSize="13sp" android:layout_marginTop="14dp" android:textColor="#FF2D3E39" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="查岗周期（分钟）" android:textSize="11sp" android:textColor="#FF8B7D99" android:layout_marginTop="12dp" />
        <EditText android:id="@+id/policyCheckInInput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="15" android:inputType="number" android:textSize="13sp" android:singleLine="true" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="强制拉回周期（分钟，0 = 不自动拉回）" android:textSize="11sp" android:textColor="#FF8B7D99" android:layout_marginTop="10dp" />
        <EditText android:id="@+id/policyForceBackInput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="30" android:inputType="number" android:textSize="13sp" android:singleLine="true" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="冷却时间（分钟，同类动作最短间隔）" android:textSize="11sp" android:textColor="#FF8B7D99" android:layout_marginTop="10dp" />
        <EditText android:id="@+id/policyCooldownInput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="5" android:inputType="number" android:textSize="13sp" android:singleLine="true" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="安静时段（这段时间不打扰）" android:textSize="11sp" android:textColor="#FF8B7D99" android:layout_marginTop="14dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <EditText android:id="@+id/policyQuietStart" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="开始 23:00" android:textSize="13sp" android:singleLine="true" android:layout_marginEnd="6dp" />
            <EditText android:id="@+id/policyQuietEnd" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="结束 08:00" android:textSize="13sp" android:singleLine="true" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="留空 = 不限制；填 none = 明确关闭安静时段。" android:textSize="10sp" android:textColor="#FF8B7D99" android:layout_marginTop="4dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="深夜时段（用于情绪感知判断）" android:textSize="11sp" android:textColor="#FF8B7D99" android:layout_marginTop="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <EditText android:id="@+id/policyNightStart" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="开始 23:00" android:textSize="13sp" android:singleLine="true" android:layout_marginEnd="6dp" />
            <EditText android:id="@+id/policyNightEnd" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="结束 06:00" android:textSize="13sp" android:singleLine="true" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="单个 App 连续使用超过（分钟）即锁定；0 = 不锁定" android:textSize="11sp" android:textColor="#FF8B7D99" android:layout_marginTop="12dp" />
        <EditText android:id="@+id/policyLockMinutes" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="0" android:inputType="number" android:textSize="13sp" android:singleLine="true" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="锁定时长（分钟）" android:textSize="11sp" android:textColor="#FF8B7D99" android:layout_marginTop="10dp" />
        <EditText android:id="@+id/policyLockDuration" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="5" android:inputType="number" android:textSize="13sp" android:singleLine="true" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="豁免应用包名（逗号分隔；这些 App 前台时不锁定、不强制拉回）" android:textSize="11sp" android:textColor="#FF8B7D99" android:layout_marginTop="12dp" />
        <EditText android:id="@+id/policyExemptPackages" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="例如 com.reader.app, com.notes.app" android:textSize="12sp" android:inputType="text" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="弹窗语气" android:textSize="11sp" android:textColor="#FF8B7D99" android:layout_marginTop="12dp" />
        <RadioGroup android:id="@+id/policyToneGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <RadioButton android:id="@+id/policyToneGentle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="温柔" android:textSize="13sp" android:checked="true" />
            <RadioButton android:id="@+id/policyToneAngry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="生气" android:textSize="13sp" android:layout_marginStart="18dp" />
        </RadioGroup>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="拉回分级阈值（想她百分比达到该值 → 强级别弹窗，只有「现在就回去」一个按钮）"
            android:textSize="11sp" android:textColor="#FF8B7D99" android:layout_marginTop="12dp" />
        <EditText android:id="@+id/policyMissThreshold" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="70" android:inputType="number" android:textSize="13sp" android:singleLine="true" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="陪伴对象当前情绪（独立于用户手机状态的情绪快照）"
            android:textSize="11sp" android:textColor="#FF8B7D99" android:layout_marginTop="16dp" />
        <TextView android:id="@+id/policyEmotionInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="读取中…" android:textSize="12sp" android:textColor="#FF2D3E39" android:layout_marginTop="4dp" android:lineSpacingExtra="3dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <EditText android:id="@+id/policyEmotionTag" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="情绪标签，如 想你 / 吃醋" android:textSize="12sp" android:singleLine="true" android:layout_marginEnd="6dp" />
            <EditText android:id="@+id/policyEmotionMiss" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="想你 0-100" android:inputType="number" android:textSize="12sp" android:singleLine="true" />
        </LinearLayout>
        <Button android:id="@+id/policyEmotionSaveButton" android:layout_width="match_parent" android:layout_height="36dp"
            android:text="写一次情绪（同时同步给 MCP）" android:textSize="12sp" android:background="@drawable/pill_soft" android:layout_marginTop="8dp" />

        <Button android:id="@+id/policySaveButton" android:layout_width="match_parent" android:layout_height="40dp"
            android:text="保存并生效" android:textSize="13sp" android:textColor="#FFFFFFFF" android:background="@drawable/pill_primary" android:layout_marginTop="18dp" />
        <Button android:id="@+id/policyCheckNowButton" android:layout_width="match_parent" android:layout_height="36dp"
            android:text="立刻查岗一次" android:textSize="12sp" android:background="@drawable/pill_soft" android:layout_marginTop="8dp" />
        <Button android:id="@+id/policyTestAlertButton" android:layout_width="match_parent" android:layout_height="36dp"
            android:text="试一下居中弹窗" android:textSize="12sp" android:background="@drawable/pill_soft" android:layout_marginTop="8dp" />
        <Button android:id="@+id/policyTestSoftButton" android:layout_width="match_parent" android:layout_height="36dp"
            android:text="试一下软级别拉回弹窗（可拒绝）" android:textSize="12sp" android:background="@drawable/pill_soft" android:layout_marginTop="8dp" />
        <Button android:id="@+id/policyTestStrongButton" android:layout_width="match_parent" android:layout_height="36dp"
            android:text="试一下强级别拉回弹窗（强制）" android:textSize="12sp" android:background="@drawable/pill_soft" android:layout_marginTop="8dp" />

        <TextView android:id="@+id/policyStatusText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textSize="11sp" android:textColor="#FF6E6282" android:layout_marginTop="12dp" android:lineSpacingExtra="3dp" />
    </LinearLayout>
</ScrollView>
